# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Comma-separated list of portal origins allowed to embed the chatbot in an iframe.
# Used for: CSP frame-ancestors, CORS headers, and postMessage origin validation.
# Use * to allow all origins. Example: https://portal.com,https://staging.portal.com
NEXT_PUBLIC_ALLOWED_ORIGINS=https://your-portal.com

# Set to "true" to show the model selector UI (default: hidden, uses claude-sonnet-4-20250514)
NEXT_PUBLIC_ENABLE_MODEL_SELECTOR=false

# Set to "true" to show the file attachment button (default: hidden)
NEXT_PUBLIC_ENABLE_ATTACHMENTS=false

# Show/hide the public/private visibility selector on chats (default: shown)
NEXT_PUBLIC_ENABLE_CHAT_VISIBILITY=true

# Show/hide the Delete All Chats button in the sidebar (default: shown)
NEXT_PUBLIC_ENABLE_DELETE_ALL_CHATS=true

# Show/hide the user profile / avatar / login-logout in the sidebar footer (default: shown)
NEXT_PUBLIC_ENABLE_USER_PROFILE=true

# Portal API base URL for token validation — server-side only
PORTAL_API_URL=https://your-portal-api.com

# Feature flag: enable postMessage event auth flow (default: false)
NEXT_PUBLIC_ENABLE_EVENT_AUTH=false

# MySQL event database (fielddrive)
EVENT_DB_HOST=****
EVENT_DB_USER=****
EVENT_DB_PASSWORD=****
EVENT_DB_NAME=****
